{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kartonkerels",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "KartonkerelsApp",
      "image": "./Dockerfile",
      "instance_type": "basic",
      // Exactly one instance: SQLite + Litestream must never have two writers.
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "APP", "class_name": "KartonkerelsApp" }]
  },
  "exports": {
    "KartonkerelsApp": { "type": "durable-object", "storage": "sqlite" }
  },
  "vars": {
    "R2_PATH": "kartonkerels",
    "SLEEP_AFTER": "30m"
  }
}
