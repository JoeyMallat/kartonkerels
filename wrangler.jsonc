{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kartonkerels",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "KartonkerelsApp",
      "scheduling_policy": "durable_object",
      // Image and instance size are chosen in src/index.ts. A single Durable Object
      // ("main") owns the container, so SQLite + Litestream never have two writers.
      "images": {
        "app": { "dockerfile": "./Dockerfile" }
      }
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "APP", "class_name": "KartonkerelsApp" }]
  },
  "exports": {
    "KartonkerelsApp": { "type": "durable-object", "storage": "sqlite" }
  },
  "vars": {
    "R2_PATH": "kartonkerels",
    "SLEEP_AFTER": "30m"
  }
}
